DB_NAME=nilebank
DB_USER=nilebank
DB_PASSWORD=replace-with-a-local-demo-password
COOKIE_SECURE=false


# Optional Google Sign-In. Create a Web application OAuth client outside this repository.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Pinned delayed reference source: cbm (seven currencies), or ecb (MMK unavailable).
FX_REFERENCE_PROVIDER=cbm

# Generates tracker records only; never moves simulated bank funds.
FINANCE_SCHEDULER_ENABLED=true
