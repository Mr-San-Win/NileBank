DB_NAME=nilebank
DB_USER=nilebank
DB_PASSWORD=replace-with-a-local-demo-password
COOKIE_SECURE=false


# Optional Google Sign-In. Create a Web application OAuth client outside this repository.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Pinned delayed reference source: cbm (seven currencies), or ecb (MMK unavailable).
FX_REFERENCE_PROVIDER=cbm

# Generates tracker records only; never moves simulated bank funds.
FINANCE_SCHEDULER_ENABLED=true

# Production template only: set real operator-managed HTTPS origin and restricted
# proxy peer regex outside Git; these blank placeholders intentionally cannot deploy.
APP_PUBLIC_URL=
TRUSTED_PROXY_REGEX=

# Production NEW-volume bootstrap only; separate from the non-superuser app role.
DB_ADMIN_USER=nilebank_bootstrap
DB_ADMIN_PASSWORD=

# Optional SMTP password recovery; disabled without verified delivery.
RECOVERY_ENABLED=false
RECOVERY_BASE_URL=http://localhost:8080
RECOVERY_FROM=
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASSWORD=
RECOVERY_SMTP_STARTTLS=true

# Optional TOTP enrollment. Supply a protected JSON key ring outside Git.
MFA_ENABLED=false
MFA_KEYS_JSON=
MFA_ACTIVE_KEY_ID=
